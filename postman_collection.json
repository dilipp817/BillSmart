              "raw": "{\n  \"outletName\": \"Pizza Palace\",\n  \"displayname\": \"Pizza Palace Restaurant\",\n  \"outletManager\": \"John Doe\",\n  \"storeAddress\": {\n    \"building\": \"Building A\",\n    \"street\": \"Main Street\",\n    \"storelocation\": \"Downtown\",\n    \"zipCode\": \"12345\"\n  }\n}"

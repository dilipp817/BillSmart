# ============================================================
# BillSmart — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is in .gitignore and must NEVER be committed.
# ============================================================

# --- Active Profile: dev | uat | prod ---
SPRING_PROFILES_ACTIVE=dev

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/billsmart_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_local_db_password_here

# --- JWT Secret (min 32 chars, use a strong random string in UAT/prod) ---
APP_JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# --- SSL (dev uses bundled keystore; set false if terminated at load balancer) ---
# SERVER_SSL_ENABLED=false
# SSL_KEY_STORE_PASSWORD=changeit

# --- Server Port ---
# PORT=8443

# ============================================================
# UAT EXAMPLE  (SPRING_PROFILES_ACTIVE=uat)
# ============================================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://uat-db-host:5432/billsmart_uat
# SPRING_DATASOURCE_USERNAME=billsmart_uat_user
# SPRING_DATASOURCE_PASSWORD=strong_uat_password
# APP_JWT_SECRET=uat-strong-random-secret-min-32-chars

# ============================================================
# PRODUCTION EXAMPLE  (SPRING_PROFILES_ACTIVE=prod)
# All of these are REQUIRED — the app will fail to start without them.
# ============================================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://prod-db-host:5432/billsmart_prod
# SPRING_DATASOURCE_USERNAME=billsmart_prod_user
# SPRING_DATASOURCE_PASSWORD=very_strong_prod_password
# APP_JWT_SECRET=prod-very-strong-random-secret-min-64-chars
# PORT=10000

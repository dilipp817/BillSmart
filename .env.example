# Spring Profile
# Use 'dev' for development, 'prod' for production
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mydb_dev
SPRING_DATASOURCE_USERNAME=myuser_dev
SPRING_DATASOURCE_PASSWORD=mypassword_dev

# Logging (optional)
LOGGING_LEVEL_COM_AUTOBILL_BILLSMART=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=DEBUG

# Server (optional)
SERVER_PORT=8080

# ============================================
# PRODUCTION EXAMPLE (use when SPRING_PROFILES_ACTIVE=prod)
# ============================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mydb
# SPRING_DATASOURCE_USERNAME=myuser
# SPRING_DATASOURCE_PASSWORD=mypassword
# LOGGING_LEVEL_COM_AUTOBILL_BILLSMART=INFO
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN